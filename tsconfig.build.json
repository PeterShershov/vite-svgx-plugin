{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    /* No `declarationMap`/`sourceMap`: the package ships `dist` without `src`,
       so the maps would point at sources that aren't there. */
    "outDir": "dist",
    "rootDir": "src",
    /* Source imports carry `.ts` extensions; rewrite them to `.js` in the JS
       emit. Declaration files keep `.ts` — TypeScript resolves those to the
       neighbouring `.d.ts`. */
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
